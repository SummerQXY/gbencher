{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gbench:schema:rule:1",
  "title": "gcpbench rule file",
  "type": "object",
  "additionalProperties": false,
  "required": ["dsl_version", "benchmark", "rules"],
  "properties": {
    "dsl_version": { "type": "integer", "const": 1 },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string" },
        "section": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "cel": { "type": "string", "minLength": 1 },
    "template": { "type": "string", "minLength": 1 },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "capability": { "type": "string", "enum": ["kubectl", "workspace-admin", "org-access"] },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "title", "profile", "cis_assessment", "mode", "severity", "scope", "check", "remediation", "notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9](\\.[0-9]+)*$" },
        "ref": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "enum": ["L1", "L2"] },
        "cis_assessment": { "type": "string", "enum": ["automated", "manual"] },
        "mode": { "type": "string", "enum": ["deterministic", "contextual"] },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
        "scope": { "type": "string", "enum": ["project", "organization", "cluster"] },
        "evaluate_per": { "type": "string", "enum": ["organization", "project"] },
        "services": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9.-]+\\.googleapis\\.com$" } },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
        "collect": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "resource": { "$ref": "#/$defs/resource" },
        "params": { "type": "object" },
        "params_constraints": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/param_constraint" }
        },
        "check": { "$ref": "#/$defs/check" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/cel" } },
        "remediation": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "notes": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "cluster" } } },
          "then": {},
          "else": { "required": ["collect"], "properties": { "collect": { "minItems": 1 } } }
        },
        {
          "if": { "required": ["scope"], "properties": { "scope": { "const": "organization" } } },
          "then": { "required": ["evaluate_per"] },
          "else": { "properties": { "evaluate_per": false } }
        }
      ]
    },
    "param_constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "enum": { "type": "array" },
        "max_length": { "type": "integer", "minimum": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "gcloud": { "$ref": "#/$defs/template" },
        "api": { "$ref": "#/$defs/api" },
        "kubectl": { "$ref": "#/$defs/template" },
        "foreach": { "$ref": "#/$defs/cel" },
        "as": { "$ref": "#/$defs/identifier" },
        "attach": { "$ref": "#/$defs/identifier" },
        "parse": { "type": "string", "enum": ["json", "text", "lines"] },
        "on_error": { "type": "string", "enum": ["error", "empty", "skip", "ignore"] },
        "cross_project": { "type": "boolean" },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true }
      },
      "oneOf": [
        { "required": ["gcloud"] },
        { "required": ["api"] },
        { "required": ["kubectl"] }
      ]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "url": { "$ref": "#/$defs/template" },
        "body": { "type": "object" },
        "paginate": { "type": "boolean" },
        "list_field": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" } }
      },
      "dependentRequired": { "paginate": ["list_field"] }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "kind"],
      "properties": {
        "from": { "$ref": "#/$defs/cel" },
        "filter": { "$ref": "#/$defs/cel" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "$ref": "#/$defs/cel" },
        "key": { "$ref": "#/$defs/cel" },
        "empty": { "type": "string", "enum": ["not_applicable", "pass"] }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assert"],
      "properties": {
        "assert": { "$ref": "#/$defs/cel" },
        "review_when": { "$ref": "#/$defs/cel" },
        "message": { "$ref": "#/$defs/template" },
        "review_message": { "$ref": "#/$defs/template" }
      }
    }
  }
}
